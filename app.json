{
  "expo": {
    "name": "Bitewise",
    "slug": "Bitewise",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bitwiselogo.jpeg",
    "scheme": "Bitewise",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bitewise",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bitewise",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/bitwiselogo.jpeg",
        "backgroundImage": "./assets/images/bitwiselogo.jpeg",
        "monochromeImage": "./assets/images/bitwiselogo.jpeg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bitwiselogo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bitwiselogo.jpeg",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share your pet's images.",
          "cameraPermission": "The app accesses your camera to let you take photos of your pet."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The app accesses your camera to scan and analyze food."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b627c8ff-4754-494b-85e8-a4172ff34171"
      }
    }
  }
}
